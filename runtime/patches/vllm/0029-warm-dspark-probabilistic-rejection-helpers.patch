+def _dspark_rejection_helper_num_reqs(max_num_seqs: int) -> tuple[int, ...]:
+    """Request counts that cover the readiness probe and a small concurrent batch."""
+    counts = {1}
+    if max_num_seqs >= 4:
+        counts.add(4)
+    elif max_num_seqs > 1:
+        counts.add(int(max_num_seqs))
+    return tuple(sorted(counts))
+
+
+def _dspark_rejection_helper_draft_modes() -> tuple[bool, ...]:
+    # Cached sm121 copies compile the draft-logits callee (`cTrue`). Also
+    # cover the one-hot / no-draft-logits specialization.
+    return (False, True)
+
+
+def _warmup_dspark_probabilistic_rejection_helpers(worker: "Worker") -> None:
+    """Compile rejection_sample() helpers before enabling the JIT monitor.
+
+    DSpark is served with draft_sample_method=probabilistic. The first real
+    request otherwise JITs `_compute_local_logits_stats_kernel`,
+    `_rejection_kernel`, and `_resample_kernel`. Live Triton keys on GB10
+    split on target_logits dtype (bf16 vs f32), not on batch size.
+    """
+    spec_config = getattr(worker.vllm_config, "speculative_config", None)
+    if spec_config is None:
+        return
+    is_dspark = getattr(spec_config, "is_dspark", None)
+    if is_dspark is not None:
+        if not is_dspark():
+            return
+    elif getattr(spec_config, "method", None) != "dspark":
+        return
+
+    num_spec = int(getattr(spec_config, "num_speculative_tokens", 0) or 0)
+    if num_spec < 1:
+        return
+
+    from vllm.v1.worker.gpu.spec_decode.rejection_sampler_utils import (
+        rejection_sample,
+    )
+
+    device = worker.model_runner.device
+    model_config = worker.vllm_config.model_config
+    get_vocab_size = getattr(model_config, "get_vocab_size", None)
+    vocab_size = (
+        int(get_vocab_size())
+        if get_vocab_size is not None
+        else int(model_config.vocab_size)
+    )
+    if vocab_size < 1:
+        return
+
+    max_num_seqs = int(worker.scheduler_config.max_num_seqs)
+    warmed = []
+    for num_reqs in _dspark_rejection_helper_num_reqs(max_num_seqs):
+        num_logits = num_reqs * (num_spec + 1)
+        cu_num_logits = torch.arange(
+            0,
+            num_logits + 1,
+            num_spec + 1,
+            dtype=torch.int32,
+            device=device,
+        )
+        idx_mapping = torch.arange(num_reqs, dtype=torch.int32, device=device)
+        expanded_idx_mapping = torch.repeat_interleave(idx_mapping, num_spec + 1)
+        expanded_local_pos = torch.arange(
+            num_spec + 1, dtype=torch.int32, device=device
+        ).repeat(num_reqs)
+        pos = torch.zeros(num_logits, dtype=torch.int64, device=device)
+        temperature = torch.ones(num_reqs, dtype=torch.float32, device=device)
+        seed = torch.zeros(num_reqs, dtype=torch.int64, device=device)
+        draft_sampled = torch.zeros(num_logits, dtype=torch.int32, device=device)
+
+        for dtype in _DSPARK_REJECTION_HELPER_DTYPES:
+            target_logits = torch.zeros(
+                (num_logits, vocab_size), dtype=dtype, device=device
+            )
+            for has_draft_logits in _dspark_rejection_helper_draft_modes():
+                draft_logits = None
+                if has_draft_logits:
+                    draft_logits = torch.zeros(
+                        (num_reqs, num_spec, vocab_size),
+                        dtype=torch.float32,
+                        device=device,
+                    )
+                rejection_sample(
+                    target_logits,
+                    draft_logits,
+                    draft_sampled,
+                    cu_num_logits,
+                    pos,
+                    idx_mapping,
+                    expanded_idx_mapping,
+                    expanded_local_pos,
+                    temperature,
+                    seed,
+                    num_spec,
+                )
+                warmed.append(
+                    (
+                        num_reqs,
+                        num_spec,
+                        str(dtype).replace("torch.", ""),
+                        has_draft_logits,
+                    )
+                )
+
+    torch.accelerator.synchronize()
+    logger.info_once(
+        "Warmed DSpark probabilistic rejection helper configurations: %s.",
+        tuple(warmed),
+    )
+
+
