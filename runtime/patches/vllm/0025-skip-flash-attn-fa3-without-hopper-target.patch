From 6f963838691d217334280161a979e2416914f9ab Mon Sep 17 00:00:00 2001
From: Chris <16943149+nepenth@users.noreply.github.com>
Date: Tue, 11 Aug 2026 22:06:00 -0400
Subject: [PATCH 25/25] [Build] Skip FlashAttention-3 without a Hopper target

The pinned vllm-flash-attn source correctly computes an empty FA3_ARCHS for
the SM121-only GB10 build, but still creates the _vllm_fa3_C target. CMake
then compiles all 194 Hopper SM90 instantiations with an implicit default
architecture. Besides adding hours to an ARM64 build, the resulting extension
cannot be selected on Blackwell.

Patch the pinned dependency during FetchContent population so it creates FA3
only when the filtered target list actually contains Hopper. FA2 and the
Blackwell-specific attention backends remain unchanged.
---
 .../patches/flash-attn-skip-fa3-without-sm90.patch | 14 ++++++++++++++
 cmake/external_projects/vllm_flash_attn.cmake      |  1 +
 2 files changed, 15 insertions(+)
 create mode 100644 cmake/external_projects/patches/flash-attn-skip-fa3-without-sm90.patch

diff --git a/cmake/external_projects/patches/flash-attn-skip-fa3-without-sm90.patch b/cmake/external_projects/patches/flash-attn-skip-fa3-without-sm90.patch
new file mode 100644
index 000000000..c3ec433e2
--- /dev/null
+++ b/cmake/external_projects/patches/flash-attn-skip-fa3-without-sm90.patch
@@ -0,0 +1,14 @@
+diff --git a/CMakeLists.txt b/CMakeLists.txt
+index f4d55a1..c3ec433 100644
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -190,2 +190,4 @@ endif ()
+-# FA3 requires CUDA 12.0 or later
+-if (FA3_ENABLED AND ${CMAKE_CUDA_COMPILER_VERSION} GREATER_EQUAL 12.0)
++# FA3 requires CUDA 12.0 or later and only supports Hopper. Do not create
++# the target when its architecture intersection is empty: an empty per-source
++# architecture list otherwise makes CMake compile every SM90 instantiation.
++if (FA3_ENABLED AND ${CMAKE_CUDA_COMPILER_VERSION} GREATER_EQUAL 12.0 AND "9.0" IN_LIST CUDA_ARCHS)
+@@ -322,0 +325,2 @@ if (FA3_ENABLED AND ${CMAKE_CUDA_COMPILER_VERSION} GREATER_EQUAL 12.0)
++elseif(FA3_ENABLED AND ${CMAKE_CUDA_COMPILER_VERSION} GREATER_EQUAL 12.0)
++    message(STATUS "FA3 is disabled because the target architectures do not include Hopper SM90.")
diff --git a/cmake/external_projects/vllm_flash_attn.cmake b/cmake/external_projects/vllm_flash_attn.cmake
index 6c3b94693..1d910cd08 100644
--- a/cmake/external_projects/vllm_flash_attn.cmake
+++ b/cmake/external_projects/vllm_flash_attn.cmake
@@ -42,6 +42,7 @@ else()
           GIT_TAG 28e862d21806bc3580207aa0ad4e2759151e9827
           GIT_SUBMODULES csrc/cutlass
           GIT_PROGRESS TRUE
+          PATCH_COMMAND git apply --unidiff-zero --whitespace=nowarn ${CMAKE_CURRENT_LIST_DIR}/patches/flash-attn-skip-fa3-without-sm90.patch
           # Don't share the vllm-flash-attn build between build types
           BINARY_DIR ${CMAKE_BINARY_DIR}/vllm-flash-attn
   )
