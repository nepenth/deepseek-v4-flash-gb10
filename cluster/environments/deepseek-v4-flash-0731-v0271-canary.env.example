# Copy to the same name without .example in the deployed head checkout. Keep
# the real cluster values outside Git.

WORKER_HOST=CHANGEME
WORKER_DIR=/home/CHANGEME/vllm-v0271-gb10
MASTER_ADDR=CHANGEME
MASTER_PORT=29501
NODE_RANK=0
HEADLESS=

NCCL_IB_HCA=CHANGEME
NCCL_SOCKET_IFNAME=CHANGEME
TP_SOCKET_IFNAME=CHANGEME
GLOO_SOCKET_IFNAME=CHANGEME
WORKER_NCCL_IB_HCA=CHANGEME
WORKER_NCCL_SOCKET_IFNAME=CHANGEME
WORKER_TP_SOCKET_IFNAME=CHANGEME
WORKER_GLOO_SOCKET_IFNAME=CHANGEME
NCCL_IB_GID_AUTO=1
NCCL_CROSS_NIC=1

HF_CACHE=/opt/models/vllm-cache
WORKER_HF_CACHE=/opt/models/vllm-cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_XET=1
DSPARK_MODEL_HOST=/opt/models/deepseek-ai--DeepSeek-V4-Flash-0731
WORKER_DSPARK_MODEL_HOST=/opt/models/deepseek-ai--DeepSeek-V4-Flash-0731
DSPARK_MODEL_CONTAINER=/models/dspark-checkpoint
DSPARK_REVISION=
SERVED_MODEL_NAME="deepseek-ai/DeepSeek-V4-Flash-0731 deepseek-v4-flash-0731"
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
VLLM_HOST_IP=CHANGEME
WORKER_VLLM_HOST_IP=CHANGEME

DSPARK_VLLM_IMAGE=dspark-vllm-gb10:v0.27.1-gb10-rc7
MAX_MODEL_LEN=400000
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION_TEXT=0.84
GPU_MEMORY_UTILIZATION_VISION=0.84
MTP_NUM_TOKENS=5
DEFAULT_THINKING=off
KV_CACHE_DTYPE=fp8_ds_mla
# Keep the global DeepSeek V4 cache at 256: C128 compressed pages need a
# nonzero storage block. The independent SWA cache already has 64-token pages.
KV_BLOCK_SIZE=256
# vLLM's MXFP4 DeepSeek V4 path no longer accepts the legacy B12X backend.
MOE_BACKEND=deep_gemm
VLLM_ALLOW_SPEC_DEC_SAME_STEP_PREFIX_HIT=2

VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
# Isolate the native 192/256-top-k SM120 module from stale FlashInfer JIT
# artifacts left by prior candidate images. This directory is not committed.
FLASHINFER_WORKSPACE_BASE=/cache/huggingface/flashinfer-dsv4-sm120-24d7dfb
# The canary profile pins a fresh rc7 cache for cold-start JIT qualification.
# Keep deployment-specific cache paths out of tracked result artifacts.
TRITON_CACHE_DIR=/cache/huggingface/triton-cache-dsv4-sm120-rc7-route-warmup
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_DEBUG=WARN
NCCL_NVLS_ENABLE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

ENABLE_VLLM_GB10_PATCH=0
ENABLE_VL_SIDECAR=0
# Optional explicit KV arena in bytes. 28235618304 = 26.3 GiB from the
# 400k-boot profiler. When set, vLLM skips leftover profiling.
# KV_CACHE_MEMORY=28235618304
