# Private switch configuration installed as /home/USER/vllm-models/vllm-switch.env.
VLLM_SWITCH_WORKER_SSH=CHANGEME
VLLM_SWITCH_SERVICE_USER=CHANGEME
VLLM_SWITCH_SERVICE_HOME=/home/CHANGEME
VLLM_SWITCH_EXPECTED_HEAD_HOST=CHANGEME
VLLM_SWITCH_GENERIC_ENV=(
  "NCCL_SOCKET_IFNAME=CHANGEME"
  "NCCL_IB_DISABLE=0"
  "NCCL_IB_HCA=CHANGEME"
  "NCCL_BUFFSIZE=2097152"
  "NCCL_IB_GID_INDEX=CHANGEME"
  "GLOO_SOCKET_IFNAME=CHANGEME"
)
